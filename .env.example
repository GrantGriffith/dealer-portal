# Vercel Postgres — auto-populated when you link a Vercel Postgres database
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Vercel Blob — auto-populated when you link a Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# Session secret — generate a long random string (32+ chars)
# Example: openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-long-random-secret-string-at-least-32-chars

# Admin credentials (set before running /api/setup)
ADMIN_EMAIL=grant@griffithsales.com
ADMIN_PASSWORD=YourSecureAdminPassword123!
